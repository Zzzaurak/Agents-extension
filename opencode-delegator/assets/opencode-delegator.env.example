# Optional local configuration for the OpenCode Delegator plugin.
# Copy to ~/.config/opencode/opencode-delegator.env if you want defaults.

# Use an opencode model/provider that is separate from Codex billing/context.
# Example: OPENCODE_DELEGATOR_MODEL=deepseek/deepseek-chat
OPENCODE_DELEGATOR_MODEL=

# Optional opencode agent and model variant.
OPENCODE_DELEGATOR_AGENT=
OPENCODE_DELEGATOR_VARIANT=

# Optional default timeout for delegated jobs, in seconds.
OPENCODE_DELEGATOR_TIMEOUT_SEC=1800

# Optional: attach to an already-running opencode server.
OPENCODE_DELEGATOR_ATTACH=
